APP_ENV=development
APP_NAME=IMS API
API_V1_PREFIX=/api/v1

# Supabase session pooler (dev). Production target: mysql+pymysql://user:password@host:3306/ims
# URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql+psycopg://<role>.<project-ref>:<password>@<session-pooler-host>:5432/postgres?sslmode=require

FRONTEND_ORIGIN=http://localhost:5173
INSTITUTE_TIMEZONE=Asia/Kolkata

FILE_STORAGE_ROOT=./storage
MAX_UPLOAD_MB=5

LOG_LEVEL=INFO
EXPOSE_DOCS=true

# Security seam - values to be agreed with the security developer (Dhruvank). Never commit real keys.
SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AADHAAR_ENC_KEY=
AADHAAR_HASH_KEY=
