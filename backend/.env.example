APP_ENV=development
APP_NAME=IMS API
API_V1_PREFIX=/api/v1

# Supabase PostgreSQL session pooler for development and client testing.
# URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql+psycopg://<role>.<project-ref>:<password>@<session-pooler-host>:5432/postgres?sslmode=require

FRONTEND_ORIGIN=http://localhost:5173
INSTITUTE_TIMEZONE=Asia/Kolkata

FILE_STORAGE_ROOT=./storage
MAX_UPLOAD_MB=5

LOG_LEVEL=INFO
# API docs at /docs: development only; must be false or unset in production.
EXPOSE_DOCS=true

# Security seam - values to be agreed with the security developer (Dhruvank). Never commit real keys.
SESSION_HOURS=12
# Wrong passwords: from the 5th, each try waits longer (30 s, 1, 2, 4, 8 min ... at most LOGIN_LOCK_MINUTES).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WAIT_SECONDS=30
LOGIN_LOCK_MINUTES=15
# scrypt cost for passwords (production needs at least 131072); at most PASSWORD_HASH_PARALLEL at once.
PASSWORD_HASH_N=131072
PASSWORD_HASH_PARALLEL=2
# Data key: uploaded documents are encrypted with it. Keep a copy in a password manager:
# data encrypted with one key can't be read with another.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (Until 25 Nov 2026 this was AADHAAR_ENC_KEY. That name is still read, so an existing server keeps working.
#  IMS no longer collects Aadhaar, and AADHAAR_HASH_KEY is no longer used.)
DATA_ENC_KEY=

# Production: APP_ENV=production refuses to start unless FRONTEND_ORIGIN is https://, EXPOSE_DOCS is off and
# DATABASE_URL ends with ?sslmode=verify-full&sslrootcert=<CA file>. Check with: python -m app.cli check-production
# Backups (scripts/backup_db.py) use their own key, BACKUP_ENC_KEY, kept OUTSIDE this file.
# Backups older than this many days are deleted by `backup_db.py backup` / `prune` (the newest is always kept).
BACKUP_KEEP_DAYS=30
